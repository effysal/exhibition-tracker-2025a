# Postgres connection string. On Railway, add a Postgres plugin to your
# project and it sets DATABASE_URL automatically for services in the same
# project - you usually don't set this by hand there.
DATABASE_URL=postgres://user:password@localhost:5432/opatra_vero

# Set to "false" only for a local Postgres with no TLS (e.g. running via
# `pg_ctlcluster` or a local docker container). Leave unset/true on Railway.
PGSSL=false

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# eBay Browse API credentials from developer.ebay.com (production keys).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Only needed for local dev with a separate `vite` process; Railway serves
# everything from one process so this isn't used there.
PORT=3000
