rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Internal brand-protection tool: any signed-in user (accounts are
    // created manually in the Firebase console, so this is effectively
    // an allowlist of trusted staff) may read/write app data. Cloud
    // Functions use the Admin SDK and bypass these rules entirely.
    match /listings/{listingId} {
      allow read, write: if request.auth != null;
    }
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
